{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run function_app.py script (no Functions host)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/function_app.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "${input:runTarget}"
      ]
    },
    {
      "name": "Debug Azure Functions host (timer/http)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 9091
      },
      "justMyCode": true,
      "preLaunchTask": "func: host start"
    }
  ],
  "inputs": [
    {
      "id": "runTarget",
      "type": "pickString",
      "description": "function_app.py argument",
      "options": [
        "all",
        "shelter",
        "env",
        "forecast"
      ],
      "default": "all"
    }
  ]
}
